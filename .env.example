# Every var here is optional - the game runs fine with none of them set,
# degrading gracefully feature-by-feature (see the modules named below).
# Copy this file to `.env` and fill in what you actually have.

# Matchmaking (server/) - see src/systems/matchmaking.js
VITE_MATCHMAKING_URL=http://localhost:3000

# Leaderboard (client/server/leaderboard-server.js) - see src/systems/leaderboard.js
VITE_LEADERBOARD_URL=ws://localhost:8787
VITE_LEADERBOARD_ROOM=global

# Bloxity Legion SDK - see src/systems/bloxity.js. The game boots and stays
# fully playable even if sdk.bloxity.io is unreachable or this is unset.
# TODO: replace with this game's real slug, as registered on bloxity.io.
VITE_BLOXITY_GAME_SLUG=dino-evolution-clicker
